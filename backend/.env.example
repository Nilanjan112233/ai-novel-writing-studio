MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=novelforge
USE_MOCK_LLM=true
BACKUP_DIRECTORY=
SUPPORT_BUNDLE_DIRECTORY=
BACKUP_RETENTION_COUNT=10
MINIMUM_FREE_SPACE_MB=512
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
# Optional for a shared desktop machine. Use the same value in
# NEXT_PUBLIC_NOVELFORGE_LOCAL_TOKEN for the locally served frontend.
LOCAL_ACCESS_TOKEN=
SETTINGS_KEY_FILE=./data/settings.key
